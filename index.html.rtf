    <script>\
        // --- Gemini API Integration ---\
        const apiKey = ""; // Empty string for environment-provided key\
\
        const generateBtn = document.getElementById('generate-btn');\
        const aiResult = document.getElementById('ai-result');\
        const loadingSpinner = document.getElementById('loading-spinner');\
        const contentDisplay = document.getElementById('content-display');\
        const userMoodInput = document.getElementById('user-mood');\
\
        const meditationEl = document.getElementById('meditation-text');\
        const soundEl = document.getElementById('sound-rec');\
        const breathEl = document.getElementById('breath-rec');\
\
        async function generateRestSession(prompt, retries = 5, delay = 1000) \{\
            const systemPrompt = "You are Selah AI, a meditation and wellness guide. Based on the user's mood, provide a customized meditation plan in JSON format. Fields: 'meditation' (a short 3-sentence soothing script), 'sound' (suggested environment sound), 'breathing' (breathing pattern description). Use Korean language.";\
            \
            const payload = \{\
                contents: [\{ parts: [\{ text: prompt \}] \}],\
                systemInstruction: \{ parts: [\{ text: systemPrompt \}] \},\
                generationConfig: \{ \
                    responseMimeType: "application/json",\
                    responseSchema: \{\
                        type: "OBJECT",\
                        properties: \{\
                            meditation: \{ type: "STRING" \},\
                            sound: \{ type: "STRING" \},\
                            breathing: \{ type: "STRING" \}\
                        \}\
                    \}\
                \}\
            \};\
\
            for (let i = 0; i < retries; i++) \{\
                try \{\
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=$\{apiKey\}`, \{\
                        method: 'POST',\
                        headers: \{ 'Content-Type': 'application/json' \},\
                        body: JSON.stringify(payload)\
                    \});\
                    \
                    if (!response.ok) throw new Error('API request failed');\
                    \
                    const result = await response.json();\
                    return JSON.parse(result.candidates[0].content.parts[0].text);\
                \} catch (error) \{\
                    if (i === retries - 1) throw error;\
                    await new Promise(r => setTimeout(r, delay * Math.pow(2, i)));\
                \}\
            \}\
        \}\
\
        generateBtn.addEventListener('click', async () => \{\
            const moodText = userMoodInput.value.trim();\
            if (!moodText) return;\
\
            // UI State Change\
            aiResult.classList.remove('hidden');\
            loadingSpinner.classList.remove('hidden');\
            contentDisplay.classList.add('hidden');\
            generateBtn.disabled = true;\
            generateBtn.classList.add('opacity-50');\
\
            try \{\
                const data = await generateRestSession(moodText);\
                \
                meditationEl.textContent = `"$\{data.meditation\}"`;\
                soundEl.textContent = data.sound;\
                breathEl.textContent = data.breathing;\
\
                loadingSpinner.classList.add('hidden');\
                contentDisplay.classList.remove('hidden');\
            \} catch (err) \{\
                alert("AI \uc0\u49464 \u49496  \u49373 \u49457  \u51473  \u50724 \u47448 \u44032  \u48156 \u49373 \u54664 \u49845 \u45768 \u45796 . \u51104 \u49884  \u54980  \u45796 \u49884  \u49884 \u46020 \u54644  \u51452 \u49464 \u50836 .");\
                aiResult.classList.add('hidden');\
            \} finally \{\
                generateBtn.disabled = false;\
                generateBtn.classList.remove('opacity-50');\
            \}\
        \});\
\
        // --- Original Scroll Animation ---\
        const observerOptions = \{ threshold: 0.15 \};\
        const observer = new IntersectionObserver((entries) => \{\
            entries.forEach(entry => \{\
                if (entry.isIntersecting) \{\
                    entry.target.style.opacity = "1";\
                    entry.target.style.transform = "translateY(0)";\
                \}\
            \});\
        \}, observerOptions);\
\
        document.querySelectorAll('section > div').forEach(el => \{\
            el.style.opacity = "0";\
            el.style.transform = "translateY(40px)";\
            el.style.transition = "all 1.2s cubic-bezier(0.16, 1, 0.3, 1)";\
            observer.observe(el);\
        \});\
    </script>\
